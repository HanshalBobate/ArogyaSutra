# AWS Configuration
NEXT_PUBLIC_AWS_REGION=ap-south-1
APP_AWS_REGION=ap-south-1

# Cognito User Pools
NEXT_PUBLIC_COGNITO_PATIENT_POOL_ID=
NEXT_PUBLIC_COGNITO_PATIENT_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOCTOR_POOL_ID=
NEXT_PUBLIC_COGNITO_DOCTOR_CLIENT_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Storage & HealthLake
NEXT_PUBLIC_S3_BUCKET=arogyasutra-medical-docs
NEXT_PUBLIC_HEALTHLAKE_DATASTORE_ID=

# AWS IAM Credentials (Optional for local UI test)
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# KMS & Notifications
KMS_KEY_ID=
SNS_TOPIC_ARN=

# DynamoDB Tables
DYNAMODB_AUDIT_TABLE=arogyasutra-audit-logs
DYNAMODB_ACCESS_TABLE=arogyasutra-access-grants
DYNAMODB_SESSION_TABLE=arogyasutra-sessions
DYNAMODB_HEALTH_RECORDS_TABLE=arogyasutra-health-records
DYNAMODB_CHECKUPS_TABLE=arogyasutra-checkups
DYNAMODB_APPOINTMENTS_TABLE=arogyasutra-appointments

# Bedrock Models
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
KIMI_BEDROCK_MODEL=moonshotai.kimi-k2.5
